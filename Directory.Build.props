<Project>
    <PropertyGroup>
        <!-- Folder containing SpaceEngineers.exe -->
        <Bin64>$(registry:HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Steam App 244850@InstallLocation)\Bin64</Bin64>
        <Bin64 Condition="'$(Bin64)' == '\Bin64'">C:\Program Files (x86)\Steam\steamapps\common\SpaceEngineers\Bin64</Bin64>

        <!-- Folder containing SpaceEngineersDedicated.exe -->
        <DS64>$(registry:HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Steam App 298740@InstallLocation)\DedicatedServer64</DS64>
        <DS64 Condition="'$(DS64)' == '\DedicatedServer64'">C:\Program Files (x86)\Steam\steamapps\common\SpaceEngineersDedicatedServer\DedicatedServer64</DS64>
        
        <!-- Plugin version -->
        <Version>10.0.0</Version>
        <AssemblyVersion>10.0.5.0</AssemblyVersion>
        <FileVersion>10.0.5.0</FileVersion>
    </PropertyGroup>
</Project>